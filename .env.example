# Server Configuration
PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/inkroom

# Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-random-128bit
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Storage
ASSET_STORAGE=local
UPLOAD_DIR=./uploads
BOARD_RETENTION_DAYS=30

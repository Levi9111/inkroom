# Server Configuration
PORT=8080
NODE_ENV=development
PUBLIC_URL=http://localhost:8080

# Database
DATABASE_URL=mongodb://127.0.0.1:27017/inkroom
MONGODB_URI=mongodb://127.0.0.1:27017/inkroom

# Security & Auth
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=inkroom_super_secret_jwt_access_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_SECRET=inkroom_super_secret_jwt_refresh_key_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Storage & Uploads
UPLOAD_DIR=./uploads
BOARD_RETENTION_DAYS=30

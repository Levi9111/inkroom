{
  "name": "inkroom-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Inkroom: a free, open-source, real-time classroom whiteboard",
  "license": "MIT",
  "author": "Inkroom Contributors",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
